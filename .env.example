# 必填：飞书/Lark 应用凭据。
# 请在飞书/Lark 开放平台创建应用，并启用机器人能力和 WebSocket 长连接事件订阅。
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 国内飞书租户使用 "feishu"，国际版 Lark 租户使用 "lark"。
FEISHU_DOMAIN=feishu

# 机器人展示与消息处理行为。
BOT_NAME=Claude Code
SEND_TYPING_ACK=true
REQUIRE_MENTION_IN_GROUP=true

# 可选：允许使用机器人的飞书/Lark open_id 白名单，多个值用英文逗号分隔。
# 留空表示允许所有能向机器人发送消息的用户。
ALLOW_USER_IDS=

# 本地网关行为。
MAX_QUEUE_SIZE=200
TEXT_CHUNK_LIMIT=3800
ENABLE_CLAUDE_CHANNEL_NOTIFICATIONS=true

# 可选：本地状态目录，后续可用于保存状态、日志、下载文件或访问规则。
# 默认值：~/.claude/claudecode_lark_mcp
CLAUDECODE_LARK_STATE_DIR=
